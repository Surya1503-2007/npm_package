{
  "name": "@surya1503/repo-audit",
  "version": "1.0.0",
  "description": "Production-grade CLI tool to audit JavaScript and TypeScript repositories for unused dependencies, oversized packages, and duplicate versions.",
  "author": "Surya",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Surya1503-2007/npm_package.git"
  },
  "bugs": {
    "url": "https://github.com/Surya1503-2007/npm_package/issues"
  },
  "homepage": "https://github.com/Surya1503-2007/npm_package#readme",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "repo-audit": "bin/repo-audit.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "audit",
    "dependencies",
    "dependency-check",
    "unused-dependencies",
    "package-size",
    "duplicate-packages",
    "cli",
    "npm",
    "typescript",
    "lockfile"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@babel/parser": "^7.26.9",
    "commander": "^13.1.0",
    "fast-glob": "^3.3.3",
    "ora": "^8.2.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.24",
    "eslint": "^9.21.0",
    "prettier": "^3.5.3",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.73.0",
    "vitest": "^3.0.7"
  }
}
